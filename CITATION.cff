license: GPL-3.0-only
repository-code: "https://github.com/fcarvajalbrown/Symbio-Grid"
keywords:
  - agent-based model
  - mesa
  - artificial life
  - evolutionary simulation
  - mycorrhizal symbiosis
  - complex adaptive systems
